# MoreWerx company "backbone" — the ECP site reads live content from, and posts
# contact leads to, its MoreWerx company account. Leave unset to serve the
# built-in static content (identical to the original design).
NEXT_PUBLIC_MOREWERX_API=https://morewerx.com
NEXT_PUBLIC_ECP_SLUG=ecp

# Public address of this site (canonical / og:url for shared blog links).
# Optional on Vercel — defaults to the project's production domain.
NEXT_PUBLIC_SITE_URL=https://ecp-website-taupe.vercel.app
